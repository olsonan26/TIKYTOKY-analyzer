# The worker first loads the repository's .env.local, then this worker/.env.
# Reuse its existing OPENROUTER_API_KEY. Never put credentials in NEXT_PUBLIC_ variables.
# No Browser Use cloud key, Apify key, Supadata key, or paid search key is required.
# Local Browser Use and GPT Researcher still consume the configured OpenRouter model.
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# OPENROUTER_VISION_MODEL=deepseek/deepseek-v4.1-flash

# Bind defaults to 127.0.0.1. Pair the dashboard with the local worker.
# Leave unset to generate a token automatically in .data/worker-token.txt.
# If you set a token yourself, use at least 32 random characters and keep it private.
# WORKER_TOKEN=
# WORKER_DATA_DIR=
WORKER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4199,http://127.0.0.1:4199

# Browser Use has no cloud sync, extensions, CAPTCHA solver, or stealth bypass.
WORKER_HEADLESS=true
BROWSER_AGENT_MAX_STEPS=18
TIKTOK_API_ENABLED=true
ANONYMIZED_TELEMETRY=false
BROWSER_USE_CLOUD_SYNC=false
BROWSER_USE_SETUP_LOGGING=false

# Local CPU transcription: first use downloads weights; model names are recorded in evidence.
# tiny is faster for smoke checks; base is the default; small needs more time/memory.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Research runs in its own virtual environment because its MCP version differs.
# The worker locates research-runtime/.venv automatically. Set only for a custom location.
# WORKER_RESEARCH_PYTHON=
# Optional self-hosted metasearch endpoint; no paid search API is required.
SEARXNG_URL=http://127.0.0.1:8080
