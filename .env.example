# Server-side only. Never prefix provider keys with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Required on Vercel. At least 16 characters; this gates paid API access.
APP_PASSWORD=

# Optional automatic TikTok discovery (paid provider account).
APIFY_API_TOKEN=
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
APIFY_MAX_CHARGE_USD=1
APIFY_DOWNLOAD_VIDEOS=true

# Optional automatic YouTube discovery.
YOUTUBE_API_KEY=

# Optional URL transcription for supported social platforms.
SUPADATA_API_KEY=
